# Server
PORT=3847
NODE_ENV=development

# Database — Railway Postgres sets DATABASE_URL automatically when you attach a DB.
# Local dev: omit DATABASE_URL and use SQLite at DATABASE_PATH instead.
# DATABASE_URL=postgresql://user:pass@host:5432/railway
DATABASE_PATH=./data/madeon.db

# Shopify Admin API
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_DISCOUNT_PERCENT=10

# Resend (optional locally — dev uses mock codes when these are empty)
RESEND_API_KEY=
# Must be a verified domain in Resend — NOT @gmail.com / @yahoo.com.
# Quick test: Madeon <onboarding@resend.dev> (only sends to your Resend login email)
# Production: Madeon <noreply@yourdomain.com> after verifying yourdomain.com at resend.com/domains
RESEND_FROM_EMAIL=Madeon <onboarding@resend.dev>

# DEV_MOCK_REWARDS=false  # force real Shopify/Resend in dev (default: mock when unset)

# Admin dashboard + dev complete (required for /api/dev/complete)
ADMIN_SECRET=change-me-local-only

# Public (optional — store URL shown in email CTA)
BUN_PUBLIC_STORE_URL=
